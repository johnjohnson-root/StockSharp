<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <!--
    Fork-branded NuGet packaging (imported for every project via common_meta.props).

    Package IDs are distinct from upstream's,
    so downstream projects depend on this Apache-2.0 fork
    in place of upstream's post-2026-07-16 (EULA) packages,
    and pushes stay clear of upstream's reserved "StockSharp.*" prefix on nuget.org.
    Assembly names, namespaces and file layout stay StockSharp.*,
    so the packages are drop-in:
    the PackageReference id in consuming projects is the single difference.

    The default prefix "StockShark" is the fork's package brand
    (decision record 0004).
    Override per pack with:

      dotnet pack StockSharp.slnx -c Release -p:ForkPackagePrefix=YourBrand

    ForkPackageVersion tracks the assembly version
    (5.0.0, the last Apache-2.0 upstream state)
    and is bumped per fork release, independently of upstream's package feeds.
  -->
  <PropertyGroup>
    <ForkPackagePrefix Condition="'$(ForkPackagePrefix)' == ''">StockShark</ForkPackagePrefix>
    <ForkPackageVersion Condition="'$(ForkPackageVersion)' == ''">5.0.0</ForkPackageVersion>
    <ForkRepositoryUrl Condition="'$(ForkRepositoryUrl)' == ''">https://github.com/johnjohnson-root/StockSharp</ForkRepositoryUrl>

    <PackageId>$(ForkPackagePrefix).$(MSBuildProjectName)</PackageId>
    <PackageVersion>$(ForkPackageVersion)</PackageVersion>

    <Authors>StockSharp community fork contributors</Authors>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <PackageProjectUrl>$(ForkRepositoryUrl)</PackageProjectUrl>
    <RepositoryUrl>$(ForkRepositoryUrl)</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>stocksharp;fork;apache-2.0;trading;algotrading;backtesting</PackageTags>
    <Description Condition="'$(Description)' == ''">$(SSProjectName) — from the Apache-2.0 community fork of the StockSharp trading platform. Assembly and namespaces are unchanged ($(SSProjectName)); only the package id is fork-branded.</Description>
  </PropertyGroup>
</Project>
