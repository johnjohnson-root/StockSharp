<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    Deterministic package sources for the standalone fork.

    Directory.Build.targets pins every external package version
    to the newest release published before 2026-07-16,
    the last Apache-2.0 upstream commit.
    Pinning holds a restore steady against version drift,
    and the Ecng.* and StockSharp.Samples.HistoryData packages
    are published by the same owner that relicensed upstream,
    so a package going unpublished or delisted stays a live risk.

    nuget-mirror/ is a local folder feed for exactly that case.
    It ships empty (README only);
    populate it with tools/mirror-packages.sh,
    which captures the full .nupkg closure both solutions build against.
    With a populated mirror the build restores from the folder feed alone:

      dotnet restore StockSharp.slnx [dash][dash]source ./nuget-mirror

    (written with [dash] because XML reserves the double dash
    for the comment delimiter;
    see nuget-mirror/README.md for the copy-pastable command)
  -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <add key="local-mirror" value="nuget-mirror" />
  </packageSources>
</configuration>
