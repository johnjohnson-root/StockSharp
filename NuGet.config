<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    Deterministic package sources for the standalone fork.

    All external package versions are pinned in Directory.Build.targets to the
    newest releases published before 2026-07-16 (the last Apache-2.0 upstream
    commit). Pinning protects against version drift, but not against packages
    being unpublished or delisted - the Ecng.* and StockSharp.Samples.HistoryData
    packages are published by the same owner that relicensed upstream.

    nuget-mirror/ is a local folder feed for exactly that case. It ships empty
    (README only); populate it with tools/mirror-packages.sh, which captures the
    full .nupkg closure both solutions build against. With a populated mirror the
    build restores even if every upstream package disappears; a fully offline
    restore is:

      dotnet restore StockSharp.slnx [dash][dash]source ./nuget-mirror

    (written with [dash] because a literal double dash is not allowed inside an
    XML comment; see nuget-mirror/README.md for the copy-pastable command)
  -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <add key="local-mirror" value="nuget-mirror" />
  </packageSources>
</configuration>
